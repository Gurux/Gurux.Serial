<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net11.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(BuildMobile)' == 'true'">net11.0;net10.0;net11.0-windows10.0.19041.0;net10.0-windows10.0.19041.0;net11.0-android;net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="'$(BuildApple)' == 'true'">net11.0;net10.0;net11.0-windows10.0.19041.0;net10.0-windows10.0.19041.0;net11.0-android;net10.0-android;net11.0-ios;net10.0-ios</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
        <PackageId>Gurux.Serial</PackageId>
        <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Gurux/Gurux.Serial</RepositoryUrl>
        <Authors>Gurux Ltd</Authors>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>GXSerial.png</PackageIcon>
        <Copyright>Copyright (c) 1998-2026 Gurux Ltd. All rights reserved.</Copyright>
        <Company>Gurux Ltd</Company>
        <Description>Modern .NET 10 and 11 Serial media with asynchronous transport and optional Android adapters.</Description>
        <Version Condition="'$(BUILD_BUILDNUMBER)' == ''">0.0.1-local</Version>
        <Version Condition="'$(BUILD_BUILDNUMBER)' != ''">$(BUILD_BUILDNUMBER)</Version>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GuruxCommonVersion Condition="'$(GuruxCommonVersion)' == ''">9.0.*</GuruxCommonVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="System.IO.Ports" Version="11.0.0" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">
        <PackageReference Include="Tmds.DBus" Version="0.95.2" />
    </ItemGroup>
    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
        <None Include="GXSerial.png" Pack="true" PackagePath="/" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Properties/Resources.resx" />
        <EmbeddedResource Include="Bluetooth/devices.csv" LogicalName="Gurux.Serial.BluetoothDevices.csv" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Gurux.Common" Version="9.0.2611.1801" />
    </ItemGroup>
    <ItemGroup>
        <!-- Legacy Windows Forms editors do not belong to the UI-independent transport library. -->
        <Compile Remove="Shared/PropertiesForm.cs;Shared/PropertiesForm.Designer.cs" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="GXSerial.png" LogicalName="Gurux.Serial.MediaIcon.png" />
    </ItemGroup>
</Project>
