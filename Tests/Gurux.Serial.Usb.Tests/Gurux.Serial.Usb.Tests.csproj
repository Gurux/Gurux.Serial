<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Development/Gurux.Serial.csproj" />
    <Compile Include="../../Development/Android/Usb/AndroidUsbConfiguration.cs" Link="Production/AndroidUsbConfiguration.cs" />
    <Compile Include="../../Development/Android/Usb/AndroidUsbProtocol.cs" Link="Production/AndroidUsbProtocol.cs" />
    <Compile Include="../../Development/Android/Usb/AndroidUsbChipset.cs" Link="Production/AndroidUsbChipset.cs" />
    <Compile Include="../../Development/Properties/Resources.cs" Link="Production/Resources.cs" />
    <EmbeddedResource Include="../../Development/Properties/Resources.resx" LogicalName="Gurux.Serial.Properties.Resources.resources" />
  </ItemGroup>
</Project>
