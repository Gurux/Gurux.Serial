<EditForm Model="Draft" OnSubmit="Save">
    <h2>@Properties.Resources.MediaSettings</h2>
    @foreach (var field in Draft.Fields)
    {
        <div class="mb-3" @key="field.Id">
            <label class="form-label" for="@field.Id">@field.Label</label>
            @if (field.Kind == "toggle")
            {
                <GXInputCheckbox TValue="bool" id="@field.Id" @bind-Value="field.Checked" />
            }
            else if (field.Kind == "choice" || field.Kind == "port")
            {
                <InputSelect class="form-select" id="@field.Id" @bind-Value="field.Value" disabled="@(!field.IsEnabled)">
                    @if (field.Kind == "port" || string.IsNullOrEmpty(field.Value))
                    {
                        <option value="" disabled hidden></option>
                    }
                    @foreach (var choice in field.Choices) { <option value="@choice">@choice</option> }
                </InputSelect>
            }
            else if (field.Kind == "password")
            {
                <GXInputPassword id="@field.Id" @bind-Value="field.Value" autocomplete="off" />
            }
            else if (field.Kind == "multiline")
            {
                <GXInputTextArea id="@field.Id" @bind-Value="field.Value" />
            }
            else
            {
                <GXInputText id="@field.Id" @bind-Value="field.Value" inputmode="@(field.Kind == "number" ? "numeric" : "text")" />
            }
        </div>
    }
    <BluetoothDevicePicker Model="Draft.Bluetooth" Changed="BluetoothChanged" CancellationToken="CancellationToken" />
    @if (_error is not null) { <p role="alert" class="text-danger">@_error</p> }
    @if (!Embedded)
    {
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@(_completed || !Draft.CanSave)">@Properties.Resources.Save</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel" disabled="@_completed">@Properties.Resources.Cancel</button>
    </div>
    }
</EditForm>
@code {
    /// <summary>Leaves validation and persistence to the containing editor and hides local actions.</summary>
    [Parameter] public bool Embedded { get; set; }
    /// <summary>The host-owned staged settings transaction.</summary>
    [Parameter, EditorRequired] public MediaSettingsDraft Draft { get; set; } = default!;
    /// <summary>Called once with true after save or false after cancellation.</summary>
    [Parameter] public EventCallback<bool> Completed { get; set; }
    /// <summary>Cancels this editing session without saving.</summary>
    [Parameter] public CancellationToken CancellationToken { get; set; }
    /// <summary>Stores a localized validation message.</summary>
    private string? _error;
    /// <summary>Prevents duplicate form submissions.</summary>
    private bool _completed;
    /// <summary>Handles Bluetooth selection changes so Blazor refreshes this form's port controls and Save availability.</summary>
    /// <remarks>Blazor automatically renders this form after its event callback completes.</remarks>
    private void BluetoothChanged()
    {
    }
    /// <summary>Validates and commits the staged values.</summary>
    /// <returns>A task completing after save notification.</returns>
    private async Task Save()
    {
        if (_completed || Embedded) { return; }
        try
        {
            CancellationToken.ThrowIfCancellationRequested();
            Draft.Commit();
            _completed = true;
            await Completed.InvokeAsync(true);
        }
        catch (Exception failure)
        {
            _error = string.Format(System.Globalization.CultureInfo.CurrentCulture,
                Properties.Resources.InvalidSettingsDetails, failure.Message);
        }
    }
    /// <summary>Notifies the owner to discard edits.</summary>
    /// <returns>A task completing after cancellation notification.</returns>
    private async Task Cancel()
    {
        if (_completed) { return; }
        _completed = true;
        await Completed.InvokeAsync(false);
    }
}
